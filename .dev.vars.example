# Copia este archivo a .dev.vars para desarrollo local.
# En producción, cárgalos como secretos en Cloudflare, nunca en el repo.
ACCESS_TOKEN=token_permanente_del_usuario_del_sistema
APP_SECRET=app_secret_de_agente_logidma
VERIFY_TOKEN=frase_para_verificar_el_webhook
ADMIN_EMAIL=tu-correo@ejemplo.com
DASHBOARD_PASSWORD=contraseña-inicial
# Opcional: solo si eliges Claude como proveedor de IA.
ANTHROPIC_API_KEY=
# Opcional: con esta llave, cada mensaje entrante se reenvía por correo a ADMIN_EMAIL.
BREVO_API_KEY=
