{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agente-logidma",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  // Dominio público del agente. Cloudflare crea el DNS y el certificado.
  // Solo se atiende en wa.logidma.com: *.workers.dev y las preview URLs
  // quedan apagadas.
  "routes": [{ "pattern": "wa.logidma.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Frontend (React) compilado por Vite en /dist. El Worker solo atiende
  // /api/* y /webhook; el resto lo sirve Cloudflare como sitio estático.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agente-logidma",
      "database_id": "8e3a8d25-afc0-4a0c-b60d-625c8ac5022f",
      "migrations_dir": "migrations"
    }
  ],

  // Multimedia recibida y enviada. Solo el Worker la lee (no es pública).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "agente-logidma-media" }],

  // WebSocket de avisos en tiempo real para el panel.
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "RealtimeHub" }]
  },

  // Workers AI: uno de los dos proveedores del asistente (el otro es la Claude API).
  "ai": { "binding": "AI", "remote": true },

  // v1 creó el Durable Object del historial original; v2 lo elimina
  // (los mensajes ahora viven en D1); v3 crea el de tiempo real.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MessageStore"] },
    { "tag": "v2", "deleted_classes": ["MessageStore"] },
    { "tag": "v3", "new_sqlite_classes": ["RealtimeHub"] }
  ],

  // Valores no secretos. Los secretos (ACCESS_TOKEN, APP_SECRET,
  // VERIFY_TOKEN, ADMIN_EMAIL, DASHBOARD_PASSWORD y, opcionales,
  // ANTHROPIC_API_KEY y BREVO_API_KEY) se cargan con
  // `wrangler secret put` o en el panel de Cloudflare, nunca aquí.
  "vars": {
    "PHONE_NUMBER_ID": "1253350567872957",
    "WABA_ID": "4659287351061167",
    "APP_ID": "4790523007843058",
    "GRAPH_API_VERSION": "v23.0"
  }
}
